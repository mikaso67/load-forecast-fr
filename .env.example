# Copy this file to .env at the repository root and fill the empty values.
# Set a local database username and password. Never commit .env.
# Single-quote the password in .env if it contains dollar signs or hash signs.
POSTGRES_DB=load_forecast
POSTGRES_USER=
POSTGRES_PASSWORD=

# Set this in the client environment when logging runs to MLflow.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Clean relation used by all Python readers and the API.
LFF_CLEAN_TABLE=analytics.load_30min

# Development dbt builds and new MLflow run authorship.
DBT_TARGET=dev
LFF_DEV_SCHEMA=dev
LFF_AUTHOR=developer

# Native production scheduling. Provision trusted A/B checkpoints before enabling it.
LFF_RUNTIME_DIR=
LFF_SNAPSHOT_SCHEMA=
LFF_BASE_CLEAN_TABLE=analytics.load_30min
LFF_PRODUCTION_EXPERIMENT_ID=
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_EPHEMERAL_ENABLED=false

# Static site publication: use a dedicated clone already on gh-pages.
LFF_SITE_CLONE=
LFF_REPLAY_DIR=
# Read-only site connection when POSTGRES_* identifies the production writer.
LFF_DATABASE_URL=
